{
  "name": "@mydenicek/docs-api",
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read src/main.ts",
    "check": "deno check src/main.ts",
    "fmt": "deno fmt src deno.json",
    "fmt:check": "deno fmt --check src deno.json",
    "lint": "deno lint src"
  },
  "imports": {
    "fastify": "npm:fastify@^5.2.1",
    "@azure/data-tables": "npm:@azure/data-tables@^13.3.1",
    "@azure/identity": "npm:@azure/identity@^4.7.0",
    "@mydenicek/shared-auth": "../../packages/shared-auth/mod.ts",
    "@mydenicek/shared-types": "../../packages/shared-types/mod.ts"
  }
}
