{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.42.1.51946",
      "templateHash": "6101893502487552132"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "westeurope",
      "metadata": {
        "description": "Azure region for the deployment script resource (not the Entra object)."
      }
    },
    "appDisplayName": {
      "type": "string",
      "defaultValue": "mydenicek",
      "metadata": {
        "description": "Display name for the Entra app registration."
      }
    },
    "scriptIdentityId": {
      "type": "string",
      "defaultValue": "TODO_SCRIPT_IDENTITY_RESOURCE_ID",
      "metadata": {
        "description": "Resource ID of a User-Assigned Managed Identity with Directory.ReadWrite.All (Graph) permission."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Resource tags."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deploymentScripts",
      "apiVersion": "2023-08-01",
      "name": "[format('ds-entra-app-{0}', parameters('appDisplayName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "AzureCLI",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', parameters('scriptIdentityId'))]": {}
        }
      },
      "properties": {
        "azCliVersion": "2.57.0",
        "retentionInterval": "P1D",
        "scriptContent": "      set -e\n      EXISTING=$(az ad app list --display-name \"${APP_DISPLAY_NAME}\" --query \"[0].appId\" -o tsv 2>/dev/null || true)\n      if [ -z \"$EXISTING\" ]; then\n        APP_ID=$(az ad app create --display-name \"${APP_DISPLAY_NAME}\" --sign-in-audience AzureADMyOrg --query appId -o tsv)\n      else\n        APP_ID=$EXISTING\n      fi\n      echo \"{\\\"appId\\\": \\\"$APP_ID\\\"}\" > $AZ_SCRIPTS_OUTPUT_PATH\n    ",
        "environmentVariables": [
          {
            "name": "APP_DISPLAY_NAME",
            "value": "[parameters('appDisplayName')]"
          }
        ],
        "cleanupPreference": "OnSuccess"
      }
    }
  ],
  "outputs": {
    "appId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deploymentScripts', format('ds-entra-app-{0}', parameters('appDisplayName'))), '2023-08-01').outputs.appId]"
    }
  }
}