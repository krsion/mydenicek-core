{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.42.1.51946",
      "templateHash": "12203050849937563181"
    }
  },
  "parameters": {
    "lawId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the Log Analytics Workspace to send diagnostics to."
      }
    },
    "resourceIds": {
      "type": "array",
      "metadata": {
        "description": "List of resource IDs to create diagnostic settings for."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Resource tags."
      }
    }
  },
  "resources": [
    {
      "copy": {
        "name": "diagnosticSettings",
        "count": "[length(parameters('resourceIds'))]"
      },
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "name": "[format('diag-to-law-{0}', copyIndex())]",
      "properties": {
        "workspaceId": "[parameters('lawId')]",
        "logs": [
          {
            "categoryGroup": "allLogs",
            "enabled": true,
            "retentionPolicy": {
              "enabled": false,
              "days": 0
            }
          }
        ],
        "metrics": [
          {
            "category": "AllMetrics",
            "enabled": true,
            "retentionPolicy": {
              "enabled": false,
              "days": 0
            }
          }
        ]
      }
    }
  ]
}