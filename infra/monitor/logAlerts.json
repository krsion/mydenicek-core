{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.42.1.51946",
      "templateHash": "1308274951786134457"
    }
  },
  "parameters": {
    "workspaceResourceId": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics workspace resource ID."
      }
    },
    "actionGroupResourceId": {
      "type": "string",
      "metadata": {
        "description": "Action group resource ID."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Alert location."
      }
    }
  },
  "variables": {
    "$fxv#0": "AppTraces\n| where TimeGenerated > ago(5m)\n| where Message has \"Invalid event signature\" or Message has \"Signed events are required\"\n| summarize failures = count()\n"
  },
  "resources": [
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "signature-verification-failures",
      "location": "[parameters('location')]",
      "properties": {
        "description": "Signature verification failures > 0 in 5 minutes.",
        "enabled": true,
        "severity": 2,
        "evaluationFrequency": "PT5M",
        "windowSize": "PT5M",
        "scopes": [
          "[parameters('workspaceResourceId')]"
        ],
        "criteria": {
          "allOf": [
            {
              "query": "[variables('$fxv#0')]",
              "timeAggregation": "Count",
              "operator": "GreaterThan",
              "threshold": 0,
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "actions": {
          "actionGroups": [
            "[parameters('actionGroupResourceId')]"
          ]
        }
      }
    }
  ]
}