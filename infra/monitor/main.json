    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[format('diag-{0}', parameters('environment'))]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "lawId": {
            "value": "[parameters('lawId')]"
          },
          "resourceIds": {
            "value": [
              "[parameters('syncVmssId')]",
              "[parameters('docsAppId')]",
              "[parameters('aclVmId')]"
            ]
          },
          "tags": {
            "value": "[parameters('tags')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.42.1.51946",
              "templateHash": "12203050849937563181"
            }
          },
          "parameters": {
            "lawId": {
              "type": "string",
              "metadata": {
                "description": "Resource ID of the Log Analytics Workspace to send diagnostics to."
              }
            },
            "resourceIds": {
              "type": "array",
              "metadata": {
                "description": "List of resource IDs to create diagnostic settings for."
